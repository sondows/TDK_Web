# Replace/merge with the existing tdkon.myasustor.com site block; do not add a duplicate block.
# Add the exact VPN client subnet to each remote_ip matcher before enabling VPN access.
# This example permits the restaurant LAN only: 192.168.0.0/24.
tdkon.myasustor.com {
	@tdkpos path /tdkpos /tdkpos/*
	handle @tdkpos {
		@trustedPos remote_ip 192.168.0.0/24
		handle @trustedPos {
			reverse_proxy 192.168.0.83:3000 {
				header_up Host {host}
				header_up -X-TDK-Trusted-Network
				header_up X-TDK-Trusted-Network caddy-vpn-validated
			}
		}
		respond "Forbidden" 403
	}

	@tdkkds path /tdkkds /tdkkds/*
	handle @tdkkds {
		@trustedKds remote_ip 192.168.0.0/24
		handle @trustedKds {
			reverse_proxy 192.168.0.83:3000 {
				header_up Host {host}
				header_up -X-TDK-Trusted-Network
				header_up X-TDK-Trusted-Network caddy-vpn-validated
			}
		}
		respond "Forbidden" 403
	}

	@tdkadm path /tdkadm /tdkadm/*
	handle @tdkadm {
		reverse_proxy 192.168.0.83:3000 {
			header_up Host {host}
			header_up -X-TDK-Trusted-Network
		}
	}

	# POS/KDS browser fetches use root-level APIs; keep these behind the same network gate.
	@protectedApis path /api/auth /api/auth/* /api/staff/active /api/table-cancellations /api/tables /api/kds/table-order /api/pos /api/pos/* /api/table-sessions* /api/table-session-merges* /api/table-layout* /api/order-items* /api/checkouts* /api/sales* /api/kitchen /api/kitchen/* /api/admin/verify /api/admin/verify-pin /api/admin/grant /api/admin/discount-rules /api/admin/menus* /api/admin/staff*
	handle @protectedApis {
		@trustedApi remote_ip 192.168.0.0/24
		handle @trustedApi {
			reverse_proxy 192.168.0.83:3000 {
				header_up Host {host}
				header_up -X-TDK-Trusted-Network
				header_up X-TDK-Trusted-Network caddy-vpn-validated
			}
		}
		respond "Forbidden" 403
	}

	# Root-to-admin redirect, shared admin APIs, and Next.js assets.
	handle {
		reverse_proxy 192.168.0.83:3000 {
			header_up Host {host}
			header_up -X-TDK-Trusted-Network
		}
	}
}
