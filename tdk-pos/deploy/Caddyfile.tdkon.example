# Legacy reference only. For the current unified-path deployment use
# Caddyfile.unified-paths.example; this older sample lacks the app ingress
# origin header and must not be applied with the new server.cjs.
# Replace/merge with the existing tdkon.myasustor.com site block; do not add a duplicate block.
# KDS network identity uses Caddy's client_ip, not browser-supplied IP headers.
# NAS eth0 is confirmed as 192.168.0.83/24. Verify that Caddy sees each real
# client IP before using 192.168.0.0/24 as the KDS exemption CIDR.
# Set KDS_PROXY_SHARED_SECRET to the same 64-character random hex value in
# Caddy's environment and the app's .env.production before enabling LAN bypass.
# If another proxy is in front of Caddy, configure only that proxy's exact IP
# under Caddy's global trusted_proxies and enable trusted_proxies_strict.
# Do not trust private_ranges or an unverified LAN proxy address.
# POS remains LAN-only; KDS still requires employee authentication everywhere.
tdkon.myasustor.com {
	@tdkpos path /tdkpos /tdkpos/*
	handle @tdkpos {
		@trustedPos remote_ip 192.168.0.0/24
		handle @trustedPos {
			reverse_proxy 192.168.0.83:3000 {
				header_up Host {host}
				header_up X-TDK-KDS-Client-IP {client_ip}
				header_up X-TDK-KDS-Proxy-Secret {env.KDS_PROXY_SHARED_SECRET}
				header_up -X-TDK-Trusted-Network
				header_up X-TDK-Trusted-Network caddy-vpn-validated
				header_up X-Real-IP {remote_host}
			}
		}
		respond "Forbidden" 403
	}

	@tdkkds path /tdkkds /tdkkds/*
	handle @tdkkds {
		reverse_proxy 192.168.0.83:3000 {
			header_up Host {host}
			header_up X-TDK-KDS-Client-IP {client_ip}
			header_up X-TDK-KDS-Proxy-Secret {env.KDS_PROXY_SHARED_SECRET}
			header_up -X-TDK-Trusted-Network
			header_up X-Real-IP {remote_host}
		}
	}

	@tdkadm path /tdkadm /tdkadm/*
	handle @tdkadm {
		reverse_proxy 192.168.0.83:3000 {
			header_up Host {host}
			header_up X-TDK-KDS-Client-IP {client_ip}
			header_up X-TDK-KDS-Proxy-Secret {env.KDS_PROXY_SHARED_SECRET}
			header_up -X-TDK-Trusted-Network
			header_up X-Real-IP {remote_host}
		}
	}

	# POS and existing privileged APIs remain network-gated. /api/kitchen is
	# intentionally outside this matcher; its handlers require a valid KDS session.
	@protectedApis path /api/auth /api/auth/* /api/staff/active /api/table-cancellations /api/tables /api/kds/table-order /api/pos /api/pos/* /api/table-sessions* /api/table-session-merges* /api/table-layout* /api/order-items* /api/checkouts* /api/sales* /api/admin/verify /api/admin/verify-pin /api/admin/grant /api/admin/discount-rules /api/admin/menus* /api/admin/staff*
	handle @protectedApis {
		@trustedApi remote_ip 192.168.0.0/24
		handle @trustedApi {
			reverse_proxy 192.168.0.83:3000 {
				header_up Host {host}
				header_up X-TDK-KDS-Client-IP {client_ip}
				header_up X-TDK-KDS-Proxy-Secret {env.KDS_PROXY_SHARED_SECRET}
				header_up -X-TDK-Trusted-Network
				header_up X-TDK-Trusted-Network caddy-vpn-validated
				header_up X-Real-IP {remote_host}
			}
		}
		respond "Forbidden" 403
	}

	# Root-to-admin redirect, shared admin APIs, and Next.js assets.
	handle {
		reverse_proxy 192.168.0.83:3000 {
			header_up Host {host}
			header_up X-TDK-KDS-Client-IP {client_ip}
			header_up X-TDK-KDS-Proxy-Secret {env.KDS_PROXY_SHARED_SECRET}
			header_up -X-TDK-Trusted-Network
			header_up X-Real-IP {remote_host}
		}
	}
}
