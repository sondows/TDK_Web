# Copy to .env.production on the NAS and fill in actual values.
# DB_HOST must remain reachable after switching the app to host networking.
# For NAS MariaDB, use its configured NAS address and port.
DB_HOST=REPLACE_WITH_NAS_LAN_IP_OR_DNS
DB_PORT=3306
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=TDK_POS

# Used to sign temporary POS administrator grants. Use a long random value.
ADMIN_GRANT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Use false only while accessing the POS over HTTP on the trusted NAS LAN.
# Change to true when serving the site over HTTPS. If omitted, production defaults to true.
SESSION_COOKIE_SECURE=false

# KDS LAN device-registration exemption. NAS eth0 is 192.168.0.83/24, so the
# candidate store LAN is 192.168.0.0/24. Leave CIDRs blank until Caddy's actual
# client IP and any upstream proxy path have been verified. IPv4 CIDRs only.
# Generate a 32-byte secret with: openssl rand -hex 32
# The app uses this value for direct-LAN attestation and Caddy origin checks.
# Set the same value in the Caddy container environment; do not commit it.
KDS_PROXY_SHARED_SECRET=REPLACE_WITH_64_CHARACTER_RANDOM_HEX
KDS_INTERNAL_CIDRS=
KDS_INTERNAL_VPN_CIDRS=
TDK_APP_BIND_HOST=192.168.0.83
KDS_DIRECT_HOST=192.168.0.83:3000
# The store gateway is 192.168.0.1; deny its address in case router NAT hides clients.
KDS_DIRECT_EXCLUDED_IPS=192.168.0.1

# Browser-side receipt and cash drawer calls default to http://127.0.0.1:5168 on the POS PC.
# To change the port, pass NEXT_PUBLIC_DEVICE_AGENT_URL as a Docker build argument
# and rebuild the image; runtime .env.production alone cannot change browser code.
# The Device Agent must allow the POS site's exact Origin in CashDrawer:AllowedOrigins.

# Optional existing storage overrides; the compose mounts match these defaults.
# MENU_IMAGE_STORAGE_PATH=/app/public/uploads/menu
# RECEIPT_LOGO_STORAGE_PATH=/app/storage/receipt-logo
# MENU_IMAGE_PUBLIC_BASE_URL=
